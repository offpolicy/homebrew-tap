diff --git a/src/tests/emulation-synchronized-output.test b/src/tests/emulation-synchronized-output.test
new file mode 100755
index 0000000..f88c617
--- /dev/null
+++ b/src/tests/emulation-synchronized-output.test
@@ -0,0 +1,43 @@
+#!/bin/sh
+
+#
+# Synchronized output (DEC private mode 2026): everything drawn inside a frame reaches the
+# client, both when the application ends the frame and when it never does (mosh-server
+# publishes a frame that stays open past its hold).
+#
+
+# shellcheck source=e2e-test-subrs
+. "$(dirname "$0")/e2e-test-subrs"
+PATH=$PATH:.:$srcdir
+# Top-level wrapper.
+if [ $# -eq 0 ]; then
+    e2e-test "$0" baseline direct verify
+    exit
+fi
+
+# OK, we have arguments, we're one of the test hooks.
+if [ $# -ne 1 ]; then
+    fail "bad arguments %s\n" "$@"
+fi
+
+baseline()
+{
+    printf '\033[H\033[J'
+    # Frames the application ends, drawn in two writes each.
+    for row in 1 2 3; do
+        printf '\033[?2026h\033[%d;1Hframe %d' "$row" "$row"
+        sleepf
+        printf ' ended\033[?2026l'
+        sleepf
+    done
+    # A frame never ended: its contents still arrive, once mosh-server's hold runs out.
+    printf '\033[?2026h\033[5;1Hframe never ended'
+    sleep 2
+}
+
+case $1 in
+    baseline|direct)
+        baseline;;
+    *)
+        fail "unknown test argument %s\n" "$1";;
+esac
