+/* Request DEC private mode (DECRQM, CSI ? Ps $ p), answered for synchronized output only.
+   Applications such as Zellij ask before they bracket a redraw with mode 2026, and bracket
+   nothing when no answer comes. Every other mode stays unanswered, as before. */
+static void CSI_DECRQM( Framebuffer* fb, Dispatcher* dispatch )
+{
+  if ( dispatch->getparam( 0, 0 ) == 2026 ) {
+    /* 1: set, 2: reset */
+    dispatch->terminal_to_host.append( fb->ds.synchronized_output ? "\033[?2026;1$y" : "\033[?2026;2$y" );
+  }
+}
+
+static Function func_CSI_DECRQM( CSI, "?$p", CSI_DECRQM, false );
