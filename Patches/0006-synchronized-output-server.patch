+/* Synchronized output (DEC private mode 2026; mosh issue #1312).
+ *
+ * An application brackets a redraw with "begin frame" (CSI ? 2026 h) and "end frame"
+ * (CSI ? 2026 l) so that the terminal never shows it half drawn. mosh-server publishes the
+ * framebuffer to the client on its own schedule, so a publish could land mid-redraw: Zellij
+ * hides the cursor, rewrites the screen in many writes and shows the cursor again, and a
+ * snapshot from the middle reached the client as the cursor vanishing for one send interval.
+ *
+ * While a frame is open the client keeps the last complete state. The new state goes out when
+ * the frame ends, or once the frame has been open for HOLD_MS if the application never ends it.
+ * Each new "begin frame" gets its own HOLD_MS. */
+class FrameHold
+{
+private:
+  static const uint64_t HOLD_MS = 250;
+  bool open;
+  unsigned int begin; /* the "begin frame" being held for */
+  uint64_t since;
+
+public:
+  /* A publish that was held back and still has to go out. */
+  bool pending;
+
+  FrameHold() : open( false ), begin( 0 ), since( 0 ), pending( false ) {}
+
+  /* Whether to hold the terminal's current state back from the client. */
+  bool holds( const Terminal::Complete& terminal, uint64_t now )
+  {
+    const Terminal::DrawState& ds = terminal.get_fb().ds;
+    if ( !ds.synchronized_output ) {
+      open = false;
+      return false;
+    }
+    if ( !open || ds.synchronized_output_begins != begin ) {
+      open = true;
+      begin = ds.synchronized_output_begins;
+      since = now;
+    }
+    return now - since < HOLD_MS;
+  }
+
+  /* Milliseconds until a held state is due anyway. */
+  int wait_time( uint64_t now ) const
+  {
+    if ( !pending || !open ) {
+      return INT_MAX;
+    }
+    return now - since >= HOLD_MS ? 0 : static_cast<int>( since + HOLD_MS - now );
+  }
+};
+
+/* Give the client the terminal's state, unless an open frame holds it back. */
+static void publish( ServerConnection& network, Terminal::Complete& terminal, FrameHold& hold, uint64_t now )
+{
+  if ( hold.holds( terminal, now ) ) {
+    hold.pending = true;
+  } else {
+    network.set_current_state( terminal );
+    hold.pending = false;
+  }
+}
