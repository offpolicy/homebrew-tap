+/* cursor shape */
+static void CSI_cursorshape( Framebuffer* fb, Dispatcher* dispatch )
+{
+  int shape = dispatch->getparam( 0, 0 );
+
+  fb->ds.set_cursor_shape( shape );
+}
+
+static Function func_CSI_cursorshape( CSI, " q", CSI_cursorshape );
+
 /* device attributes */
